+"""ISSN 校验位计算与校验（第五十四轮 · 并发 C 单）。
+
+本模块只依赖标准库，不依赖仓库内其他模块。函数行为以文档字符串为准：
+`issn_check_digit` 计算前 7 位的 ISSN 校验位，`issn_validate` 校验完整
+ISSN 字符串（8 位无分隔或 9 位带连字符两种形态）。
+"""
+
+__all__ = ["issn_check_digit", "issn_validate"]
+
+_WEIGHTS = (8, 7, 6, 5, 4, 3, 2)
+
+
+def issn_check_digit(seven: str) -> str:
+    """计算 7 位 ISSN 前缀的校验位。
+
+    seven 必须是恰好 7 位 ASCII 数字的字符串，否则抛 TypeError/ValueError。
+    算法：前 7 位依次乘权重 8、7、6、5、4、3、2 求和，
+    check = (11 − (sum % 11)) % 11；check == 10 返回 "X"，
+    否则返回该数字的一位字符串。
+    """
+    if not isinstance(seven, str):
+        raise TypeError("seven must be a str")
+    if len(seven) != 7 or not seven.isdigit() or not seven.isascii():
+        raise ValueError("seven must be exactly 7 ASCII digits")
+    total = sum(int(d) * w for d, w in zip(seven, _WEIGHTS))
+    check = (11 - (total % 11)) % 11
+    return "X" if check == 10 else str(check)
+
+
+def issn_validate(code: str) -> bool:
+    """校验完整 ISSN 字符串。
+
+    code 非 str 抛 TypeError。接受两种形态：
+    8 位无分隔（前 7 位数字＋末位数字或大写 X），或
+    9 位带连字符（第 5 个字符为 '-'，去掉后同前一种）。
+    形态不合一律返回 False、不抛错；形态合则按 issn_check_digit 核对末位，
+    一致返回 True，否则 False。
+    """
+    if not isinstance(code, str):
+        raise TypeError("code must be a str")
+
+    if len(code) == 9:
+        if code[4] != "-":
+            return False
+        compact = code[:4] + code[5:]
+    elif len(code) == 8:
+        compact = code
+    else:
+        return False
+
+    first7 = compact[:7]
+    last = compact[7]
+    if not (first7.isdigit() and first7.isascii()):
+        return False
+    if not (last.isdigit() or last == "X"):
+        return False
+    return last == issn_check_digit(first7)
diff --git a/tests/test_issn.py b/tests/test_issn.py
new file mode 100644
index 0000000..ba2763a
--- /dev/null
+++ b/tests/test_issn.py
@@ -0,0 +1,50 @@
+import pytest
+
+from issn import issn_check_digit, issn_validate
+
+
+def test_check_digit_real_issn():
+    # 真实 ISSN 0378-5955 的前 7 位
+    assert issn_check_digit("0378595") == "5"
+
+
+def test_check_digit_known_values():
+    assert issn_check_digit("2049363") == "0"
+    assert issn_check_digit("1234567") == "9"
+    assert issn_check_digit("0000000") == "0"
+    assert issn_check_digit("9999999") == "4"
+    assert issn_check_digit("1000002") == "X"
+
+
+def test_validate_true_forms():
+    assert issn_validate("03785955") is True
+    assert issn_validate("0378-5955") is True
+    assert issn_validate("1000002X") is True
+    assert issn_validate("1000-002X") is True
+
+
+def test_validate_false_forms():
+    assert issn_validate("03785954") is False
+    assert issn_validate("1000002x") is False
+    assert issn_validate("0378595") is False
+    assert issn_validate("0378-595") is False
+    assert issn_validate("abcdefgh") is False
+
+
+def test_check_digit_type_error():
+    with pytest.raises(TypeError):
+        issn_check_digit(378595)
+
+
+def test_validate_type_error():
+    with pytest.raises(TypeError):
+        issn_validate(None)
+
+
+def test_check_digit_value_error():
+    with pytest.raises(ValueError):
+        issn_check_digit("037859")
+    with pytest.raises(ValueError):
+        issn_check_digit("03785955")
+    with pytest.raises(ValueError):
+        issn_check_digit("0378a95")
